{
  "name": "patchday",
  "version": "0.2.2",
  "description": "Scheduled, rule-based updates for Homebrew, winget, Chocolatey and Docker with backup and rollback.",
  "license": "MIT",
  "funding": "https://ko-fi.com/kvnbe",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "scan": "node src/cli/scan.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "main": "dist/main.cjs",
  "build": {
    "appId": "io.github.kvn-be.patchday",
    "productName": "Patchday",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "artifactName": "Patchday-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Patchday-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kvn-be",
        "repo": "patchday",
        "releaseType": "prerelease"
      }
    ]
  }
}